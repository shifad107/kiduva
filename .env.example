# KIDUVA new Supabase-first backend (public browser configuration)
# Copy these into Vercel > Settings > Environment Variables. Redeploy after saving.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# IMPORTANT: NEVER put Supabase secret/service_role keys or database passwords
# in VITE_ variables. The browser only receives a public publishable key.
# Database row-level security protects admin operations.

# Legacy Shopify configuration (inactive when Supabase variables are present)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
